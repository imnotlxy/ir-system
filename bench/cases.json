{
  "description": "IR 检索系统评测用例。每条用例包含一个查询和期望命中的教师（姓名，可选学院用于消歧）。用于衡量 Hit@1 / Hit@5，评价模糊查询、拼音查询、同义词扩展等优化。",
  "cases": [
    {
      "id": "c1",
      "query": "ACM、算法、NLP",
      "expected": [
        { "name": "朱晓旭" }
      ],
      "note": "多关键词检索；期望命中 ACM 训练队教练、中文信息处理方向的朱晓旭"
    },
    {
      "id": "c2",
      "query": "周国栋",
      "expected": [
        { "name": "周国栋" }
      ],
      "note": "精确姓名检索"
    },
    {
      "id": "c3",
      "query": "zgd",
      "expected": [
        { "name": "周国栋" }
      ],
      "note": "拼音首字母检索，需启用 pinyin_query"
    },
    {
      "id": "c4",
      "query": "知识图谱、副教授",
      "expected": [
        { "name": "陈伟", "college": "计算机科学与技术学院（软件学院）" }
      ],
      "note": "研究方向+职称组合；存在同名陈伟（商学院），故用学院消歧"
    },
    {
      "id": "c5",
      "query": "周国",
      "expected": [
        { "name": "周国栋" }
      ],
      "note": "姓名前缀检索，考察模糊/放宽查询能否命中"
    },
    {
      "id": "c6",
      "query": "赵雷",
      "expected": [
        { "name": "赵雷" }
      ],
      "note": "精确姓名检索"
    },
    {
      "id": "c7",
      "query": "王红玲",
      "expected": [
        { "name": "王红玲" }
      ],
      "note": "精确姓名检索；研究方向含信息检索"
    },
    {
      "id": "c8",
      "query": "崔爽",
      "expected": [
        { "name": "崔爽" }
      ],
      "note": "精确姓名检索"
    },
    {
      "id": "c9",
      "query": "cuishuang",
      "expected": [
        { "name": "崔爽" }
      ],
      "note": "拼音全拼检索，需启用 pinyin_query"
    },
    {
      "id": "c10",
      "query": "lishoushan",
      "expected": [
        { "name": "李寿山" }
      ],
      "note": "拼音全拼检索，需启用 pinyin_query"
    },
    {
      "id": "c11",
      "query": "lss",
      "expected": [
        { "name": "李寿山" }
      ],
      "note": "拼音首字母检索，需启用 pinyin_query"
    },
    {
      "id": "c12",
      "query": "lpf",
      "expected": [
        { "name": "李培峰" }
      ],
      "note": "拼音首字母检索，需启用 pinyin_query"
    },
    {
      "id": "c13",
      "query": "zhaolei",
      "expected": [
        { "name": "赵雷" }
      ],
      "note": "拼音全拼检索，需启用 pinyin_query"
    },
    {
      "id": "c14",
      "query": "知识图谱、教授",
      "expected": [
        { "name": "赵雷" }
      ],
      "note": "研究方向+职称组合；知识图谱方向仅赵雷为教授，陈伟/吴庭芳为副教授，用于消歧"
    },
    {
      "id": "c15",
      "query": "推荐系统、最优化",
      "expected": [
        { "name": "崔爽" }
      ],
      "note": "多关键词组合；推荐系统方向仅陈伟与崔爽，叠加最优化唯一命中崔爽"
    },
    {
      "id": "c16",
      "query": "KG",
      "expected": [
        { "name": "陈伟", "college": "计算机科学与技术学院（软件学院）" }
      ],
      "note": "同义词扩展用例；KG 经同义词表映射到知识图谱，关闭同义词时零结果，开启后陈伟进 Top5"
    },
    {
      "id": "c17",
      "query": "李寿",
      "expected": [
        { "name": "李寿山" }
      ],
      "note": "姓名前缀检索，考察模糊/放宽查询能否命中"
    },
    {
      "id": "c18",
      "query": "KG 陈副教授",
      "expected": [
        { "name": "陈伟", "college": "计算机科学与技术学院（软件学院）" }
      ],
      "note": "同义词+职称+姓名前缀组合；KG 映射到知识图谱，陈副教授应命中计科院陈伟"
    },
    {
      "id": "c19",
      "query": "计科院 计算机网络",
      "expected": [
        { "name": "杨哲", "college": "计算机科学与技术学院（软件学院）" }
      ],
      "note": "学院简称+研究方向组合；计科院指计算机科学与技术学院（软件学院），计算机网络应命中杨哲"
    }
  ]
}
